{
  "name": "costard-cravate",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "wp-env start",
    "stop": "wp-env stop",
    "reset": "wp-env clean all",
    "logs": "wp-env logs",
    "wp": "wp-env run cli wp",
    "deploy": "dotenv -- bash -c 'rsync -avz --delete --exclude node_modules --exclude .git --exclude .env --exclude .wp-env.json ./ $SSH_USER@$SSH_HOST:$SSH_PATH'",
    "deploy:dry": "dotenv -- bash -c 'rsync -avzn --delete --exclude node_modules --exclude .git --exclude .env --exclude .wp-env.json ./ $SSH_USER@$SSH_HOST:$SSH_PATH'",
    "db:export": "wp-env run cli wp db export - > backup.sql",
    "db:import": "wp-env run cli wp db import /var/www/html/backup.sql",
    "export": "wp-env run cli wp export --dir=/var/www/html && mv $(ls -t *.xml 2>/dev/null | head -1) export.xml 2>/dev/null || echo 'Export created in wp-env'"
  },
  "devDependencies": {
    "@wordpress/env": "^10.0.0",
    "dotenv-cli": "^7.4.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonmeoni/costard-cravate.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/simonmeoni/costard-cravate/issues"
  },
  "homepage": "https://github.com/simonmeoni/costard-cravate#readme"
}
